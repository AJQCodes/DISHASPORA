# Dishaspora mobile — Expo public env vars (copy to `.env`).
# These are inlined into the client bundle at build time (client-visible).

# Backend base URL. Leave unset for the Android-emulator default (10.0.2.2:8080).
# LAN device: your PC IP, e.g. http://192.168.1.23:8080
# Live: your deployed backend, e.g. https://dishaspora-backend.up.railway.app
# EXPO_PUBLIC_API_URL=https://dishaspora-backend.up.railway.app

# Set to false to use the real backend instead of offline demo data.
# EXPO_PUBLIC_DEMO_MODE=false
